{
  "name": "p4-dfsjs",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"yellow.bold,magenta.bold\" --names \"BACK,FRONT\" \"npm run back\" \"npm run front\"",
    "docker": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up",
    "back": "npm --prefix backend run dev",
    "front": "npm --prefix frontend run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
